{
  "name": "aimainsi-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-runtime.mjs",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron-builder --win zip --x64 --config.electronDist=node_modules/electron/dist",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && node scripts/build-android.mjs",
    "test:local": "playwright test --config playwright.local.config.ts",
    "format": "prettier --write src server shared desktop scripts tests *.ts *.json",
    "format:check": "prettier --check src server shared desktop scripts tests *.ts *.json"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@xmldom/xmldom": "^0.9.12",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "pyodide": "^0.28.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "main": "desktop/main.mjs",
  "license": "MIT",
  "description": "Local-first AI interview practice, bring your own API.",
  "author": "AImainsi contributors",
  "build": {
    "productName": "Sequence",
    "directories": {
      "output": "release"
    },
    "artifactName": "Sequence-${version}-Windows-${arch}.${ext}",
    "appId": "org.aimainsi.sequence",
    "files": [
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "desktop/**/*",
      "public/icon.png",
      "package.json",
      "LICENSE",
      "NOTICE.md",
      "!node_modules/pyodide/**/*",
      "!node_modules/@capacitor/android/**/*"
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "asar": true
  }
}
